{
  "name": "auto_poe",
  "version": "1.0.0",
  "description": "Desktop workspace for PoE crafting",
  "main": "out/main/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write src tests tools package.json tsconfig.json electron.vite.config.ts eslint.config.mjs",
    "format:check": "prettier --check src tests tools package.json tsconfig.json electron.vite.config.ts eslint.config.mjs",
    "test": "vitest run",
    "test:calibration": "vitest run tests/calibration",
    "test:crafting": "vitest run tests/crafting",
    "probe:dev": "electron-vite dev -- --input-probe",
    "probe:start": "electron . --input-probe",
    "test:input": "vitest run tests/input tests/testbed",
    "test:native:dev": "electron-vite dev -- --input-testbed-harness",
    "test:native:start": "electron . --input-testbed-harness",
    "test:catalog": "vitest run tests/game-data",
    "probe:catalog:dev": "electron-vite dev -- --catalog-runtime-probe",
    "probe:catalog:start": "electron . --catalog-runtime-probe",
    "catalog:refresh": "node tools/catalog/refresh.ts",
    "catalog:validate": "node tools/catalog/validate.ts",
    "catalog:probe-import": "node tools/catalog/import-probe.ts"
  },
  "dependencies": {
    "koffi": "3.3.8",
    "vue": "^3.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^45.3.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.22.0",
    "eslint-plugin-vue": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue-eslint-parser": "^10.0.0",
    "vue-tsc": "^3.0.0"
  },
  "prettier": {
    "printWidth": 100
  },
  "private": true
}
